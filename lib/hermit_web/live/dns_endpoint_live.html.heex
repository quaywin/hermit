<div class="space-y-6">
  <!-- Header Section -->
  <header class="flex flex-col md:flex-row md:items-center justify-between border-b border-base-300 pb-6">
    <div>
      <h1 class="text-xl sm:text-2xl font-medium tracking-display-lg text-base-content uppercase">
        DNS Endpoints
      </h1>
      <p class="text-base-content/60 mt-1 text-xs sm:text-sm">
        Connect devices via secure DoH (iOS, macOS, Android, Browsers) or private Tailscale mesh networks.
      </p>
    </div>
    <div class="mt-4 md:mt-0 flex flex-wrap items-center gap-3">
      <button
        id="create-endpoint-btn"
        phx-click="open_new_modal"
        class="btn btn-primary rounded-[6px] text-xs font-semibold uppercase tracking-wider px-4 py-2 cursor-pointer flex items-center gap-2 w-full sm:w-auto justify-center"
      >
        <.icon name="hero-plus" class="size-4" /> Create Endpoint
      </button>
    </div>
  </header>

  <!-- Live Datagrid for Endpoints -->
  <div class="bg-base-100 border border-base-300 rounded-[12px] p-6 shadow-sm">
    <div class="w-full overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-base-300 text-base-content/60 text-xs font-medium uppercase tracking-wider">
            <th class="py-3 px-4 min-w-[170px]">Endpoint Name</th>
            <th class="py-3 px-4 min-w-[150px]">Network Type</th>
            <th class="py-3 px-4 min-w-[150px]">DNS Profile</th>
            <th class="py-3 px-4 min-w-[160px]">Node State</th>
            <th class="py-3 px-4 min-w-[210px]">Client Connect (DoH)</th>
            <th class="py-3 px-4 text-right min-w-[180px]">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-base-300 text-sm">
          <%= if Enum.empty?(@endpoints) do %>
            <tr>
              <td colspan="6" class="py-12 text-center">
                <span class="text-3xl block mb-2">🔌</span>
                <p class="text-sm font-semibold text-base-content">No DNS Endpoints yet</p>
                <p class="text-xs text-base-content/50 mt-1 max-w-sm mx-auto">
                  Create a DNS Endpoint to connect your devices or Tailscale network to a secure filtering profile.
                </p>
                <button
                  phx-click="open_new_modal"
                  class="btn btn-primary btn-sm rounded-[6px] mt-4 font-semibold text-xs text-white uppercase tracking-wider"
                >
                  Create Endpoint
                </button>
              </td>
            </tr>
          <% else %>
            <%= for endpoint <- @endpoints do %>
              <% {status, ip, err} = Map.get(@dns_statuses, endpoint.id, {:stopped, nil, nil}) %>
              <% config = endpoint.dns_profile %>
              <% doh_url = "#{@base_url}/dns-query/#{endpoint.doh_token}" %>

              <tr class="hover:bg-base-200/50 transition-colors">
                <!-- 1. Endpoint Name -->
                <td class="py-4 px-4 font-medium text-base-content">
                  <div class="flex items-center gap-2">
                    <span class="text-base">
                      <%= cond do %>
                        <% endpoint.inbound_profile_id -> %>🌐
                        <% endpoint.ddns_hostname && endpoint.ddns_hostname != "" -> %>⚡
                        <% true -> %>🛡️
                      <% end %>
                    </span>
                    <span class="font-bold text-base-content">{endpoint.name}</span>
                  </div>
                  <span class="block text-[10px] font-mono text-base-content/50 mt-0.5">
                    Token: {endpoint.doh_token}
                  </span>
                </td>

                <!-- 2. Network Type -->
                <td class="py-4 px-4">
                  <%= cond do %>
                    <% endpoint.inbound_profile_id -> %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#ff7e47]/10 text-[#ff7e47] border border-[#ff7e47]/20">
                        Tailscale Connection
                      </span>
                      <span class="block text-[10px] text-base-content/50 font-mono mt-0.5">
                        {if endpoint.inbound_profile, do: endpoint.inbound_profile.name, else: "Profile ##{endpoint.inbound_profile_id}"}
                      </span>
                    <% endpoint.ddns_hostname && endpoint.ddns_hostname != "" -> %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-500 border border-amber-500/20">
                        ⚡ Port 53 DDNS
                      </span>
                      <span class="block text-[10px] text-base-content/50 font-mono mt-0.5 truncate max-w-[140px]" title={endpoint.ddns_hostname}>
                        {endpoint.ddns_hostname}
                      </span>
                    <% true -> %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-500/10 text-blue-500 border border-blue-500/20">
                        DoH Only
                      </span>
                  <% end %>
                </td>

                <!-- 3. DNS Profile -->
                <td class="py-4 px-4">
                  <form
                    phx-change="quick_select_dns_profile"
                    id={"quick-select-dns-form-#{endpoint.id}"}
                    class="inline-block"
                  >
                    <input type="hidden" name="endpoint_id" value={endpoint.id} />
                    <select
                      name="dns_profile_id"
                      class="select select-bordered select-xs bg-base-100 border-base-300 text-xs font-semibold text-base-content rounded-[4px] focus:outline-none focus:border-primary"
                    >
                      <%= for profile <- @dns_profiles do %>
                        <option value={profile.id} selected={endpoint.dns_profile_id == profile.id}>
                          🛡️ {profile.name}
                        </option>
                      <% end %>
                    </select>
                  </form>
                </td>

                <!-- 4. Node State -->
                <td class="py-4 px-4">
                  <%= if endpoint.inbound_profile_id do %>
                    <div class="space-y-1">
                      <div>
                        <%= case status do %>
                          <% :running -> %>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
                              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                              running
                            </span>
                          <% :starting -> %>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-500 border border-amber-500/20">
                              <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-bounce"></span>
                              starting
                            </span>
                          <% :error -> %>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-500/10 text-red-500 border border-red-500/20 cursor-help" title={err}>
                              <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                              error
                            </span>
                          <% :stopped -> %>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-base-200 text-base-content/60 border border-base-300">
                              <span class="w-1.5 h-1.5 rounded-full bg-base-content/40"></span>
                              stopped
                            </span>
                        <% end %>
                      </div>
                      <%= if ip do %>
                        <span class="block text-[11px] font-mono text-base-content/70">{ip}</span>
                      <% end %>
                      <%= if config && config.tailscale_override_dns do %>
                        <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/15 text-emerald-600 border border-emerald-500/20">
                          HA Global DNS
                        </span>
                      <% end %>
                    </div>
                  <% else %>
                    <%= if endpoint.enabled do %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        Active
                      </span>
                    <% else %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-base-200 text-base-content/60 border border-base-300">
                        <span class="w-1.5 h-1.5 rounded-full bg-base-content/40"></span>
                        Inactive
                      </span>
                    <% end %>
                  <% end %>
                </td>

                <!-- 5. Client Connect (DoH & Apple Config) -->
                <td class="py-4 px-4 font-mono text-xs">
                  <div class="flex items-center gap-1.5">
                    <div class="flex items-center gap-1 bg-base-200/60 border border-base-300 rounded-[6px] px-2 py-1 max-w-[150px] sm:max-w-[180px]">
                      <code class="text-[11px] text-emerald-500 truncate flex-1 select-all">{doh_url}</code>
                      <button
                        type="button"
                        data-url={doh_url}
                        onclick="navigator.clipboard.writeText(this.getAttribute('data-url')).then(() => alert('DoH URL Copied!'))"
                        class="text-base-content/40 hover:text-emerald-500 cursor-pointer p-0.5"
                        title="Copy DoH URL"
                      >
                        <.icon name="hero-clipboard" class="size-3.5" />
                      </button>
                    </div>

                    <a
                      href={"#{doh_url}/mobileconfig"}
                      class="btn btn-ghost btn-xs text-base-content/60 hover:text-primary px-1.5"
                      title="Download Apple Profile (.mobileconfig)"
                    >
                      <.icon name="hero-arrow-down-tray" class="size-4" />
                    </a>

                    <div class="dropdown dropdown-top dropdown-end">
                      <label tabindex="0" class="btn btn-ghost btn-xs text-base-content/60 hover:text-primary px-1 cursor-pointer" title="Scan QR Code">
                        <.icon name="hero-qr-code" class="size-4" />
                      </label>
                      <div tabindex="0" class="dropdown-content z-50 p-3 bg-base-100 border border-base-300 rounded-[12px] shadow-xl mb-2 text-center w-40">
                        <div class="bg-white p-2 rounded-[6px] border border-base-300 shadow-inner inline-block">
                          <img
                            src={"https://api.qrserver.com/v1/create-qr-code/?size=110x110&data=#{URI.encode_www_form(doh_url)}"}
                            alt="QR Code"
                            class="size-[110px]"
                          />
                        </div>
                        <span class="text-[9px] uppercase tracking-wider text-base-content/50 font-semibold block mt-1">Scan for DoH</span>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- 6. Actions -->
                <td class="py-4 px-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <!-- Global DNS Override Toggle (if Tailscale) -->
                    <%= if endpoint.inbound_profile_id do %>
                      <button
                        phx-click="toggle_override_dns"
                        phx-value-id={endpoint.id}
                        disabled={status != :running}
                        class={[
                          "btn btn-xs rounded-[4px] cursor-pointer font-medium text-[11px] px-2",
                          config && config.tailscale_override_dns && "btn-success text-white",
                          !(config && config.tailscale_override_dns) && "btn-outline-custom text-base-content/70",
                          status != :running && "opacity-40 cursor-not-allowed"
                        ]}
                        title={if config && config.tailscale_override_dns, do: "Tailscale Global DNS: ON (Click to disable)", else: "Tailscale Global DNS: OFF (Click to enable)"}
                      >
                        Global DNS
                      </button>
                    <% end %>

                    <!-- Master Power Switch -->
                    <button
                      type="button"
                      phx-click="toggle_endpoint_enabled"
                      phx-value-id={endpoint.id}
                      class={[
                        "btn btn-xs rounded-[4px] cursor-pointer font-medium text-xs px-2.5",
                        endpoint.enabled && "btn-success btn-outline",
                        !endpoint.enabled && "btn-ghost border border-base-300 text-base-content/60"
                      ]}
                      title={if endpoint.enabled, do: "Click to Deactivate", else: "Click to Activate"}
                    >
                      {if endpoint.enabled, do: "Active", else: "Disabled"}
                    </button>

                    <!-- Edit Config Modal Trigger -->
                    <button
                      phx-click="edit_endpoint"
                      phx-value-id={endpoint.id}
                      class="btn btn-xs btn-outline-custom rounded-[4px] cursor-pointer font-medium text-xs px-2"
                      title="Edit Endpoint Settings"
                    >
                      <.icon name="hero-pencil-square" class="size-3.5" />
                    </button>

                    <!-- Delete Button -->
                    <button
                      phx-click="delete_endpoint"
                      phx-value-id={endpoint.id}
                      data-confirm="Are you sure you want to permanently delete this DNS Endpoint?"
                      class="btn btn-xs btn-error btn-outline rounded-[4px] cursor-pointer font-medium text-xs px-2"
                      title="Delete Endpoint"
                    >
                      <.icon name="hero-trash" class="size-3.5" />
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Create DNS Endpoint Modal -->
  <%= if @show_new_modal do %>
    <dialog id="create-endpoint-modal" class="modal modal-open z-50 backdrop-blur-sm">
      <div class="modal-box w-full max-w-lg bg-base-100 border border-base-300 p-6 space-y-4 text-base-content rounded-[16px]">
        <div class="flex items-center justify-between border-b border-base-300 pb-3">
          <h3 class="text-lg font-medium text-base-content flex items-center gap-2">
            🔌 Create DNS Endpoint
          </h3>
          <button
            type="button"
            phx-click="close_new_modal"
            class="text-base-content/60 hover:text-base-content transition-colors cursor-pointer"
          >
            <.icon name="hero-x-mark" class="size-5" />
          </button>
        </div>

        <.form
          :let={f}
          for={@new_form}
          phx-change="validate_new"
          phx-submit="save_new"
          id="create-endpoint-form"
          class="space-y-4"
        >
          <div class="space-y-1.5">
            <label class="block text-xs font-medium uppercase tracking-wider text-base-content/60">Endpoint Name</label>
            <.input
              field={f[:name]}
              type="text"
              placeholder="e.g., Personal iPhone, Office Tailnet"
              class="w-full input input-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[4px]"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs font-medium uppercase tracking-wider text-base-content/60">DNS Filtering Profile</label>
            <.input
              field={f[:dns_profile_id]}
              type="select"
              prompt="-- Choose Profile --"
              options={Enum.map(@dns_profiles, &{&1.name, &1.id})}
              class="w-full select select-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[4px]"
            />
          </div>

          <!-- Connection Type Segmented Buttons -->
          <div class="space-y-1.5">
            <label class="block text-xs font-medium uppercase tracking-wider text-base-content/60">Connection Network</label>
            <div class="grid grid-cols-3 gap-2">
              <button
                type="button"
                phx-click="select_new_type"
                phx-value-type="doh"
                class={[
                  "btn btn-xs rounded-[4px] font-semibold text-[11px]",
                  @new_connection_type == "doh" && "btn-primary text-white",
                  @new_connection_type != "doh" && "btn-ghost border border-base-300 text-base-content/70"
                ]}
              >
                🛡️ DoH Only
              </button>
              <button
                type="button"
                phx-click="select_new_type"
                phx-value-type="tailscale"
                class={[
                  "btn btn-xs rounded-[4px] font-semibold text-[11px]",
                  @new_connection_type == "tailscale" && "btn-primary text-white",
                  @new_connection_type != "tailscale" && "btn-ghost border border-base-300 text-base-content/70"
                ]}
              >
                🌐 Tailscale
              </button>
              <button
                type="button"
                phx-click="select_new_type"
                phx-value-type="ddns"
                class={[
                  "btn btn-xs rounded-[4px] font-semibold text-[11px]",
                  @new_connection_type == "ddns" && "btn-primary text-white",
                  @new_connection_type != "ddns" && "btn-ghost border border-base-300 text-base-content/70"
                ]}
              >
                ⚡ Port 53 DDNS
              </button>
            </div>
          </div>

          <%= if @new_connection_type == "tailscale" do %>
            <div class="space-y-4 bg-base-200 p-4 border border-base-300 rounded-[8px]">
              <div class="space-y-1.5">
                <label class="block text-xs font-medium uppercase tracking-wider text-base-content/60">Tailscale Inbound Profile</label>
                <.input
                  field={f[:inbound_profile_id]}
                  type="select"
                  prompt="-- Select Tailscale Inbound --"
                  options={Enum.map(@inbound_profiles, &{&1.name, &1.id})}
                  class="w-full select select-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[4px]"
                />
              </div>
            </div>
          <% else %>
            <input type="hidden" name="dns_endpoint[inbound_profile_id]" value="" />
          <% end %>

          <%= if @new_connection_type == "ddns" do %>
            <div class="space-y-4 bg-base-200 p-4 border border-base-300 rounded-[8px]">
              <div class="space-y-1.5">
                <label class="block text-xs font-medium uppercase tracking-wider text-base-content/60">DDNS Hostname</label>
                <.input
                  field={f[:ddns_hostname]}
                  type="text"
                  placeholder="e.g., myhome.duckdns.org"
                  class="w-full input input-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content font-mono text-sm rounded-[4px]"
                />
              </div>
              <div class="flex items-center justify-between pt-2 border-t border-base-300">
                <div>
                  <span class="text-xs font-medium text-base-content block">Strict DDNS IP Filter</span>
                  <span class="text-[10px] text-base-content/50 block">Only respond to requests matching WAN IP.</span>
                </div>
                <.input
                  field={f[:enable_ddns_filter]}
                  type="checkbox"
                  class="checkbox checkbox-primary checkbox-sm rounded-[4px]"
                />
              </div>
            </div>
          <% else %>
            <input type="hidden" name="dns_endpoint[ddns_hostname]" value="" />
          <% end %>

          <div class="flex items-center justify-end gap-2 pt-4 border-t border-base-300">
            <button
              type="button"
              phx-click="close_new_modal"
              class="btn btn-outline-custom rounded-[6px] text-xs uppercase tracking-wider px-4 py-2 cursor-pointer"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="btn btn-primary rounded-[6px] text-xs uppercase tracking-wider px-4 py-2 cursor-pointer text-white font-semibold"
            >
              Create Endpoint
            </button>
          </div>
        </.form>
      </div>
    </dialog>
  <% end %>

  <!-- Edit DNS Endpoint Modal -->
  <%= if @show_edit_modal do %>
    <dialog id="edit-endpoint-modal" class="modal modal-open z-50 backdrop-blur-sm">
      <div class="modal-box w-full max-w-lg bg-base-100 border border-base-300 p-6 space-y-4 text-base-content rounded-[16px]">
        <div class="flex items-center justify-between border-b border-base-300 pb-3">
          <h3 class="text-lg font-medium text-base-content flex items-center gap-2">
            ✏️ Edit DNS Endpoint
          </h3>
          <button
            type="button"
            phx-click="close_edit_modal"
            class="text-base-content/60 hover:text-base-content transition-colors cursor-pointer"
          >
            <.icon name="hero-x-mark" class="size-5" />
          </button>
        </div>

        <.form
          :let={f}
          for={@edit_form}
          phx-change="validate_edit"
          phx-submit="save_edit"
          id="edit-endpoint-form"
          class="space-y-4"
        >
          <div class="space-y-1.5">
            <label class="block text-xs font-medium uppercase tracking-wider text-base-content/60">Endpoint Name</label>
            <.input
              field={f[:name]}
              type="text"
              class="w-full input input-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[4px]"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs font-medium uppercase tracking-wider text-base-content/60">DNS Filtering Profile</label>
            <.input
              field={f[:dns_profile_id]}
              type="select"
              prompt="-- Choose Profile --"
              options={Enum.map(@dns_profiles, &{&1.name, &1.id})}
              class="w-full select select-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[4px]"
            />
          </div>

          <!-- Connection Type Segmented Buttons -->
          <div class="space-y-1.5">
            <label class="block text-xs font-medium uppercase tracking-wider text-base-content/60">Connection Network</label>
            <div class="grid grid-cols-3 gap-2">
              <button
                type="button"
                phx-click="select_edit_type"
                phx-value-type="doh"
                class={[
                  "btn btn-xs rounded-[4px] font-semibold text-[11px]",
                  @edit_connection_type == "doh" && "btn-primary text-white",
                  @edit_connection_type != "doh" && "btn-ghost border border-base-300 text-base-content/70"
                ]}
              >
                🛡️ DoH Only
              </button>
              <button
                type="button"
                phx-click="select_edit_type"
                phx-value-type="tailscale"
                class={[
                  "btn btn-xs rounded-[4px] font-semibold text-[11px]",
                  @edit_connection_type == "tailscale" && "btn-primary text-white",
                  @edit_connection_type != "tailscale" && "btn-ghost border border-base-300 text-base-content/70"
                ]}
              >
                🌐 Tailscale
              </button>
              <button
                type="button"
                phx-click="select_edit_type"
                phx-value-type="ddns"
                class={[
                  "btn btn-xs rounded-[4px] font-semibold text-[11px]",
                  @edit_connection_type == "ddns" && "btn-primary text-white",
                  @edit_connection_type != "ddns" && "btn-ghost border border-base-300 text-base-content/70"
                ]}
              >
                ⚡ Port 53 DDNS
              </button>
            </div>
          </div>

          <%= if @edit_connection_type == "tailscale" do %>
            <div class="space-y-4 bg-base-200 p-4 border border-base-300 rounded-[8px]">
              <div class="space-y-1.5">
                <label class="block text-xs font-medium uppercase tracking-wider text-base-content/60">Tailscale Inbound Profile</label>
                <.input
                  field={f[:inbound_profile_id]}
                  type="select"
                  prompt="-- Select Tailscale Inbound --"
                  options={Enum.map(@inbound_profiles, &{&1.name, &1.id})}
                  class="w-full select select-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[4px]"
                />
              </div>
            </div>
          <% else %>
            <input type="hidden" name="dns_endpoint[inbound_profile_id]" value="" />
          <% end %>

          <%= if @edit_connection_type == "ddns" do %>
            <div class="space-y-4 bg-base-200 p-4 border border-base-300 rounded-[8px]">
              <div class="space-y-1.5">
                <label class="block text-xs font-medium uppercase tracking-wider text-base-content/60">DDNS Hostname</label>
                <.input
                  field={f[:ddns_hostname]}
                  type="text"
                  placeholder="e.g., myhome.duckdns.org"
                  class="w-full input input-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content font-mono text-sm rounded-[4px]"
                />
              </div>
              <div class="flex items-center justify-between pt-2 border-t border-base-300">
                <div>
                  <span class="text-xs font-medium text-base-content block">Strict DDNS IP Filter</span>
                  <span class="text-[10px] text-base-content/50 block">Only respond to requests matching WAN IP.</span>
                </div>
                <.input
                  field={f[:enable_ddns_filter]}
                  type="checkbox"
                  class="checkbox checkbox-primary checkbox-sm rounded-[4px]"
                />
              </div>
            </div>
          <% else %>
            <input type="hidden" name="dns_endpoint[ddns_hostname]" value="" />
          <% end %>

          <div class="flex items-center justify-end gap-2 pt-4 border-t border-base-300">
            <button
              type="button"
              phx-click="close_edit_modal"
              class="btn btn-outline-custom rounded-[6px] text-xs uppercase tracking-wider px-4 py-2 cursor-pointer"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="btn btn-primary rounded-[6px] text-xs uppercase tracking-wider px-4 py-2 cursor-pointer text-white font-semibold"
            >
              Save Changes
            </button>
          </div>
        </.form>
      </div>
    </dialog>
  <% end %>
</div>
