<div class="space-y-6">
  <!-- Header Section -->
  <header class="flex flex-col md:flex-row md:items-center justify-between border-b border-base-300 pb-6">
    <div>
      <h1 class="text-xl sm:text-2xl font-medium tracking-display-lg text-base-content uppercase">
        System Overview
      </h1>
      <p class="text-base-content/60 mt-1 text-xs sm:text-sm">
        Real-time telemetry, 24-hour DNS filtering statistics, and active VPN routing tunnels.
      </p>
    </div>
    <div class="mt-4 md:mt-0 flex flex-wrap items-center gap-3">
      <.link
        navigate={~p"/dns/endpoints"}
        class="btn btn-ghost border border-base-300 rounded-[6px] text-xs font-semibold uppercase tracking-wider px-3.5 py-2 cursor-pointer flex items-center gap-1.5"
      >
        <.icon name="hero-adjustments-horizontal" class="size-4" /> Endpoints
      </.link>
      <button
        phx-click="open_create_modal"
        class="btn btn-primary rounded-[6px] text-xs font-semibold uppercase tracking-wider px-4 py-2 cursor-pointer flex items-center gap-2 w-full sm:w-auto justify-center"
      >
        <.icon name="hero-plus" class="size-4" /> Deploy Tunnel
      </button>
    </div>
  </header>

  <!-- KPI Metrics Overview -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- 1. Total Queries -->
    <div class="bg-base-100 border border-base-300 rounded-[12px] p-5 shadow-sm flex items-center justify-between">
      <div>
        <span class="text-xs font-medium uppercase tracking-wider text-base-content/60">24h DNS Queries</span>
        <div class="text-2xl font-bold font-mono text-base-content mt-1">
          {format_number(@dns_summary.total_queries)}
        </div>
        <span class="text-[11px] text-base-content/50">Total queries resolved</span>
      </div>
      <div class="p-3 rounded-full bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
        <.icon name="hero-globe-alt" class="size-6" />
      </div>
    </div>

    <!-- 2. Blocked Queries -->
    <div class="bg-base-100 border border-base-300 rounded-[12px] p-5 shadow-sm flex items-center justify-between">
      <div>
        <span class="text-xs font-medium uppercase tracking-wider text-base-content/60">Blocked Threats</span>
        <div class="text-2xl font-bold font-mono text-rose-500 mt-1">
          {format_number(@dns_summary.blocked_queries)}
        </div>
        <span class="text-[11px] text-base-content/50">Ads & malicious domains</span>
      </div>
      <div class="p-3 rounded-full bg-rose-500/10 text-rose-500 border border-rose-500/20">
        <.icon name="hero-shield-check" class="size-6" />
      </div>
    </div>

    <!-- 3. Block Rate -->
    <div class="bg-base-100 border border-base-300 rounded-[12px] p-5 shadow-sm flex items-center justify-between">
      <div>
        <span class="text-xs font-medium uppercase tracking-wider text-base-content/60">Protection Rate</span>
        <div class="text-2xl font-bold font-mono text-base-content mt-1 flex items-baseline gap-2">
          <span>{@dns_summary.block_rate}%</span>
          <%= if @dns_summary.block_rate > 0 do %>
            <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-600 border border-emerald-500/20 font-sans">Active</span>
          <% else %>
            <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-base-200 text-base-content/50 border border-base-300 font-sans">Clean</span>
          <% end %>
        </div>
        <span class="text-[11px] text-base-content/50">Ratio of blocked queries</span>
      </div>
      <div class="p-3 rounded-full bg-blue-500/10 text-blue-500 border border-blue-500/20">
        <.icon name="hero-chart-pie" class="size-6" />
      </div>
    </div>

    <!-- 4. Active Services -->
    <div class="bg-base-100 border border-base-300 rounded-[12px] p-5 shadow-sm flex items-center justify-between">
      <div>
        <span class="text-xs font-medium uppercase tracking-wider text-base-content/60">Active Services</span>
        <div class="text-2xl font-bold font-mono text-base-content mt-1">
          {@active_tunnels} <span class="text-sm font-normal text-base-content/50 font-sans">Tunnels</span>
        </div>
        <span class="text-[11px] text-base-content/50">{@active_endpoints} / {@total_endpoints} Endpoints online</span>
      </div>
      <div class="p-3 rounded-full bg-amber-500/10 text-amber-500 border border-amber-500/20">
        <.icon name="hero-server-stack" class="size-6" />
      </div>
    </div>
  </div>

  <!-- 24-Hour DNS Activity Chart -->
  <% max_queries = Enum.reduce(@dns_summary.hourly_series, 1, fn h, acc -> max(acc, h.total) end) %>
  <div class="bg-base-100 border border-base-300 rounded-[12px] p-6 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-base-300/60 gap-2">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-base-content">
          24-Hour Query Volume & Protection Activity
        </h2>
        <p class="text-xs text-base-content/50 mt-0.5">
          Hourly breakdown of queries processed vs blocked domains
        </p>
      </div>
      <div class="flex items-center gap-4 text-xs font-medium text-base-content/70">
        <div class="flex items-center gap-1.5">
          <span class="size-2.5 rounded-sm bg-emerald-500"></span>
          <span>Allowed Queries</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="size-2.5 rounded-sm bg-rose-500"></span>
          <span>Blocked Queries</span>
        </div>
      </div>
    </div>

    <!-- Chart Bars Container -->
    <div class="pt-6">
      <div class="h-36 flex items-end gap-1 sm:gap-1.5 px-1 border-b border-base-300">
        <%= for {point, idx} <- Enum.with_index(@dns_summary.hourly_series) do %>
          <% height_pct = if point.total > 0, do: max(6, round((point.total / max_queries) * 100)), else: 3 %>
          <% blocked_ratio = if point.total > 0, do: min(100, round((point.blocked / point.total) * 100)), else: 0 %>
          <div class="flex-1 flex flex-col justify-end items-center h-full group relative cursor-pointer">
            <!-- Tooltip -->
            <div class="opacity-0 group-hover:opacity-100 transition-opacity absolute bottom-full mb-2 z-20 pointer-events-none bg-base-300 text-base-content text-[11px] font-mono px-2.5 py-1.5 rounded-[6px] shadow-lg border border-base-content/10 whitespace-nowrap">
              <div class="font-bold">{point.hour_label}</div>
              <div class="text-emerald-500">Allowed: {format_number(point.total - point.blocked)}</div>
              <div class="text-rose-500">Blocked: {format_number(point.blocked)} ({blocked_ratio}%)</div>
              <div class="text-base-content/60 text-[10px] mt-0.5">Total: {format_number(point.total)}</div>
            </div>

            <!-- Bar Body -->
            <div
              style={"height: #{height_pct}%;"}
              class="w-full max-w-[28px] rounded-t-[3px] overflow-hidden flex flex-col-reverse transition-all duration-300 group-hover:brightness-110"
            >
              <!-- Allowed portion (bottom) -->
              <div
                style={"height: #{100 - blocked_ratio}%;"}
                class="w-full bg-emerald-500/80 group-hover:bg-emerald-500"
              ></div>
              <!-- Blocked portion (top) -->
              <%= if point.blocked > 0 do %>
                <div
                  style={"height: #{blocked_ratio}%;"}
                  class="w-full bg-rose-500/80 group-hover:bg-rose-500"
                ></div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Hour Axis Labels -->
      <div class="flex items-center justify-between text-[10px] font-mono text-base-content/50 pt-2 px-1">
        <%= for {point, idx} <- Enum.with_index(@dns_summary.hourly_series) do %>
          <div class={"flex-1 text-center #{if rem(idx, 4) != 0 and idx != 23, do: "hidden sm:hidden md:block opacity-0", else: ""}"}>
            {point.hour_label}
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%= if @error_tunnels != [] do %>
    <div class="bg-red-500/10 border border-red-500/30 rounded-[12px] p-4 text-sm text-base-content space-y-3 shadow-sm">
      <div class="flex items-center gap-2 font-semibold text-red-500">
        <.icon name="hero-exclamation-triangle" class="size-5 text-red-500 shrink-0" />
        <span>{length(@error_tunnels)} VPN Tunnel(s) encountered errors and need attention:</span>
      </div>
      <div class="space-y-2">
        <%= for tunnel <- @error_tunnels do %>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 bg-base-100 rounded-[8px] border border-red-500/20">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="font-mono font-bold text-base-content">{tunnel.id}</span>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-red-500/10 text-red-500 border border-red-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Error
                </span>
              </div>
              <div class="text-xs text-red-500 font-medium">
                {tunnel.ts_error_reason || tunnel.wg_error_reason || "Connection Error"}
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-2 shrink-0">
              <%= if tunnel.ts_status == :error and Map.get(tunnel, :inbound_profile_id) do %>
                <.link
                  navigate={~p"/inbounds/#{Map.get(tunnel, :inbound_profile_id)}?tab=config"}
                  class="btn btn-xs btn-error text-white font-medium text-xs"
                >
                  Update Inbound Key
                </.link>
              <% end %>
              <%= if tunnel.wg_status == :error and Map.get(tunnel, :outbound_profile_id) do %>
                <.link
                  navigate={~p"/outbounds/#{Map.get(tunnel, :outbound_profile_id)}?tab=config"}
                  class="btn btn-xs btn-warning text-white font-medium text-xs"
                >
                  Check Outbound
                </.link>
              <% end %>
              <.link
                navigate={~p"/tunnels/#{tunnel.id}"}
                class="btn btn-xs btn-ghost border border-base-300 font-medium text-xs"
              >
                View Details
              </.link>
              <button
                phx-click="restart_tunnel"
                phx-value-id={tunnel.id}
                class="btn btn-xs btn-primary font-medium text-xs"
              >
                Restart
              </button>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Live Datagrid for Tunnels -->
  <div class="bg-base-100 border border-base-300 rounded-[12px] p-6 shadow-sm">
    <div class="flex items-center justify-between pb-4 border-b border-base-300/60 mb-4">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-base-content">
          Active VPN Tunnels
        </h2>
        <p class="text-xs text-base-content/50 mt-0.5">
          Isolated network namespaces routing client traffic to outbound gateways
        </p>
      </div>
    </div>
    <div class="w-full overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-base-300 text-base-content/60 text-xs font-medium uppercase tracking-wider">
            <th class="py-3 px-4 min-w-[140px]">Name / ID</th>
            <th class="py-3 px-4 min-w-[110px]">Inbound State</th>
            <th class="py-3 px-4 min-w-[110px]">Outbound State</th>
            <th class="py-3 px-4 min-w-[110px]">Traffic (Rx/Tx)</th>
            <th class="py-3 px-4 min-w-[80px]">Ping</th>
            <th class="py-3 px-4 text-right min-w-[200px]">Actions</th>
          </tr>
        </thead>
        <tbody
          id="vpn-pairs-list"
          phx-update="stream"
          class="divide-y divide-base-300 text-sm"
        >
          <tr
            :for={{dom_id, pair} <- @streams.vpn_pairs}
            id={dom_id}
            class="hover:bg-base-200/50 transition-colors"
          >
            <td class="py-4 px-4 font-medium text-base-content">
              <div class="flex items-center gap-2">
                <%= case pair.inbound_type do %>
                  <% "tailscale" -> %>
                    <span
                      class="inline-flex items-center justify-center p-1 rounded bg-[#ff7e47]/10 text-[#ff7e47] border border-[#ff7e47]/20"
                      title="Tailscale Inbound"
                    >
                      <svg
                        class="size-4 fill-current"
                        role="img"
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <title>Tailscale</title>
                        <path d="M24 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm-9 9a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm0-9a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm6-6a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0-.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM3 24a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0-.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zm18 .5a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0-.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM6 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm9-9a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm-3 2.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM6 3a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM3 5.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" />
                      </svg>
                    </span>
                  <% "proxy" -> %>
                    <span
                      class="inline-flex items-center justify-center p-1 rounded bg-blue-500/10 text-blue-500 border border-blue-500/20"
                      title="Proxy Inbound"
                    >
                      <.icon name="hero-arrows-right-left" class="size-4" />
                    </span>
                  <% _ -> %>
                <% end %>
                <.link
                  navigate={~p"/tunnels/#{pair.id}"}
                  class="text-base-content underline hover:text-[#3ecf8e] transition-colors font-mono font-semibold"
                >
                  {pair.id}
                </.link>
              </div>
              <span class="block text-[10px] font-mono text-base-content/50 mt-0.5">
                hermit-node-{String.replace(pair.id, "_", "-")}
              </span>
            </td>
            <td class="py-4 px-4">
              <%= case pair.ts_status do %>
                <% :running -> %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    Running
                  </span>
                <% :starting -> %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-500 border border-amber-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-bounce"></span>
                    Starting
                  </span>
                <% :stopped -> %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-base-200 text-base-content/60 border border-base-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-base-content/40"></span> Stopped
                  </span>
                <% :error -> %>
                  <div class="space-y-1">
                    <span
                      class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-500/10 text-red-500 border border-red-500/20 cursor-help"
                      title={pair.ts_error_reason}
                    >
                      <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Error
                    </span>
                    <%= if pair.ts_error_reason do %>
                      <div
                        class="flex items-center gap-1 text-[11px] text-red-500 font-medium"
                        title={pair.ts_error_reason}
                      >
                        <.icon
                          name="hero-exclamation-triangle"
                          class="size-3.5 shrink-0 text-red-500"
                        />
                        <span class="truncate max-w-[130px]">
                          {summarize_error(pair.ts_error_reason)}
                        </span>
                      </div>
                    <% end %>
                  </div>
              <% end %>
            </td>
            <td class="py-4 px-4">
              <%= case pair.wg_status do %>
                <% :running -> %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    Running
                  </span>
                <% :starting -> %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-500 border border-amber-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-bounce"></span>
                    Starting
                  </span>
                <% :stopped -> %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-base-200 text-base-content/60 border border-base-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-base-content/40"></span> Stopped
                  </span>
                <% :error -> %>
                  <div class="space-y-1">
                    <span
                      class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-500/10 text-red-500 border border-red-500/20 cursor-help"
                      title={pair.wg_error_reason}
                    >
                      <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Error
                    </span>
                    <%= if pair.wg_error_reason do %>
                      <div
                        class="flex items-center gap-1 text-[11px] text-red-500 font-medium"
                        title={pair.wg_error_reason}
                      >
                        <.icon
                          name="hero-exclamation-triangle"
                          class="size-3.5 shrink-0 text-red-500"
                        />
                        <span class="truncate max-w-[130px]">
                          {summarize_error(pair.wg_error_reason)}
                        </span>
                      </div>
                    <% end %>
                  </div>
              <% end %>
            </td>
            <td class="py-4 px-4 text-xs font-mono text-base-content/60">
              <div class="flex items-center gap-1">
                <span class="text-emerald-500 font-semibold">↓</span> {format_bytes(
                  pair.metrics.bytes_received
                )}
              </div>
              <div class="flex items-center gap-1 mt-0.5">
                <span class="text-base-content/50 font-semibold">↑</span> {format_bytes(
                  pair.metrics.bytes_sent
                )}
              </div>
            </td>
            <td class="py-4 px-4 font-mono text-xs">
              <%= case Map.get(pair.metrics || %{}, :latency) do %>
                <% nil -> %>
                  <span class="text-base-content/40">-</span>
                <% :error -> %>
                  <span class="text-red-500 font-semibold">Err</span>
                <% :n_a -> %>
                  <span class="text-base-content/40">N/A</span>
                <% ms when is_integer(ms) -> %>
                  <span class="text-[#3ecf8e] font-semibold">{"#{ms} ms"}</span>
                <% _ -> %>
                  <span class="text-base-content/40">-</span>
              <% end %>
            </td>
            <td class="py-4 px-4 text-right">
              <div class="inline-flex items-center space-x-2 whitespace-nowrap">
                <%= case pair.status do %>
                  <% :running -> %>
                    <button
                      phx-click="stop_tunnel"
                      phx-value-id={pair.id}
                      title="Stop Tunnel"
                      class="btn btn-xs btn-outline btn-error rounded-[4px] cursor-pointer"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="size-4"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5.25 7.5A2.25 2.25 0 0 1 7.5 5.25h9a2.25 2.25 0 0 1 2.25 2.25v9a2.25 2.25 0 0 1-2.25 2.25h-9a2.25 2.25 0 0 1-2.25-2.25v-9Z"
                        />
                      </svg>
                    </button>
                    <button
                      phx-click="restart_tunnel"
                      phx-value-id={pair.id}
                      title="Restart Tunnel"
                      class="btn btn-xs btn-outline btn-warning rounded-[4px] cursor-pointer"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="size-4"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"
                        />
                      </svg>
                    </button>
                  <% status when status in [:starting_wg, :starting_ts] -> %>
                    <button
                      disabled
                      title="Starting..."
                      class="btn btn-xs btn-outline btn-warning rounded-[4px] opacity-50 flex items-center justify-center"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="size-4 animate-spin"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"
                        />
                      </svg>
                    </button>
                    <button
                      phx-click="stop_tunnel"
                      phx-value-id={pair.id}
                      title="Stop Tunnel"
                      class="btn btn-xs btn-outline btn-error rounded-[4px] cursor-pointer"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="size-4"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5.25 7.5A2.25 2.25 0 0 1 7.5 5.25h9a2.25 2.25 0 0 1 2.25 2.25v9a2.25 2.25 0 0 1-2.25 2.25h-9a2.25 2.25 0 0 1-2.25-2.25v-9Z"
                        />
                      </svg>
                    </button>
                  <% :error -> %>
                    <button
                      phx-click="start_tunnel"
                      phx-value-id={pair.id}
                      title="Start Tunnel"
                      class="btn btn-xs btn-outline btn-success rounded-[4px] cursor-pointer"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="size-4"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 0 1 0 1.971l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z"
                        />
                      </svg>
                    </button>
                    <button
                      phx-click="stop_tunnel"
                      phx-value-id={pair.id}
                      title="Stop Tunnel"
                      class="btn btn-xs btn-outline btn-error rounded-[4px] cursor-pointer"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="size-4"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5.25 7.5A2.25 2.25 0 0 1 7.5 5.25h9a2.25 2.25 0 0 1 2.25 2.25v9a2.25 2.25 0 0 1-2.25 2.25h-9a2.25 2.25 0 0 1-2.25-2.25v-9Z"
                        />
                      </svg>
                    </button>
                  <% _ -> %>
                    <button
                      phx-click="start_tunnel"
                      phx-value-id={pair.id}
                      title="Start Tunnel"
                      class="btn btn-xs btn-outline btn-success rounded-[4px] cursor-pointer"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="size-4"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 0 1 0 1.971l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z"
                        />
                      </svg>
                    </button>
                <% end %>

                <.link
                  navigate={~p"/tunnels/#{pair.id}"}
                  class="btn btn-xs btn-outline-custom rounded-[4px] cursor-pointer font-medium text-xs px-2.5"
                >
                  Manage
                </.link>
                <button
                  phx-click="delete"
                  phx-value-id={pair.id}
                  data-confirm="Are you sure you want to permanently delete this VPN Pair and remove all associated containers?"
                  class="btn btn-xs btn-error btn-outline rounded-[4px] cursor-pointer font-medium text-xs px-2.5"
                >
                  Delete
                </button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Deploy VPN Tunnel Modal -->
  <%= if @show_create_modal do %>
    <dialog id="deploy-tunnel-modal" class="modal modal-open z-50 backdrop-blur-sm">
      <div class="modal-box w-full max-w-lg bg-base-100 border border-base-300 p-6 space-y-4 text-base-content rounded-[16px]">
        <div class="flex items-center justify-between border-b border-base-300 pb-3">
          <h3 class="text-lg font-medium text-base-content flex items-center gap-2">
            🚀 Deploy New VPN Tunnel
          </h3>
          <button
            type="button"
            phx-click="close_create_modal"
            class="text-base-content/60 hover:text-base-content transition-colors cursor-pointer"
          >
            <.icon name="hero-x-mark" class="size-5" />
          </button>
        </div>

        <p class="text-xs text-base-content/60">
          Link an isolated inbound network interface SOCKS5/Tailscale to an outbound Wireguard gateway.
        </p>

        <%= if Enum.empty?(@inbound_profiles) or Enum.empty?(@outbound_profiles) do %>
          <div class="bg-amber-500/10 border border-amber-500/30 rounded-[10px] p-3.5 text-xs space-y-2">
            <div class="font-semibold text-amber-500 flex items-center gap-1.5">
              <.icon name="hero-information-circle" class="size-4 shrink-0" />
              <span>Setup Required Before Deploying:</span>
            </div>
            <p class="text-base-content/80 leading-relaxed text-[11px]">
              A tunnel requires at least one <strong>Inbound Profile</strong>
              (client ingress) and one <strong>Outbound Profile</strong>
              (egress gateway):
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
              <%= if Enum.empty?(@inbound_profiles) do %>
                <.link
                  navigate={~p"/inbounds"}
                  class="btn btn-xs btn-outline btn-warning gap-1.5 justify-start text-[11px]"
                >
                  <.icon name="hero-plus" class="size-3" /> Create Inbound Profile
                </.link>
              <% else %>
                <div class="flex items-center gap-1 text-emerald-500 font-medium text-[11px] py-0.5">
                  <.icon name="hero-check-circle" class="size-3.5" /> Inbound Ready
                </div>
              <% end %>

              <%= if Enum.empty?(@outbound_profiles) do %>
                <.link
                  navigate={~p"/outbounds"}
                  class="btn btn-xs btn-outline btn-warning gap-1.5 justify-start text-[11px]"
                >
                  <.icon name="hero-plus" class="size-3" /> Create Outbound Profile
                </.link>
              <% else %>
                <div class="flex items-center gap-1 text-emerald-500 font-medium text-[11px] py-0.5">
                  <.icon name="hero-check-circle" class="size-3.5" /> Outbound Ready
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <.form
          :let={f}
          for={@form}
          phx-change="validate"
          phx-submit="save"
          id="vpn-pair-form"
          class="space-y-4"
        >
          <div class="space-y-1.5">
            <label class="block text-xs font-medium uppercase tracking-wider text-base-content/60">Tunnel ID / Name</label>
            <.input
              field={f[:pair_id]}
              type="text"
              placeholder="e.g., prod_us_east"
              class="w-full input input-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content font-mono text-sm rounded-[4px]"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs font-medium uppercase tracking-wider text-base-content/60">Inbound Profile</label>
            <.input
              field={f[:inbound_profile_id]}
              type="select"
              prompt="Select an Inbound Profile"
              options={Enum.map(@inbound_profiles, &{&1.name, &1.id})}
              class="w-full select select-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[4px]"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs font-medium uppercase tracking-wider text-base-content/60">Outbound Profile</label>
            <.input
              field={f[:outbound_profile_id]}
              type="select"
              prompt="Select an Outbound Profile"
              options={Enum.map(@outbound_profiles, &{&1.name, &1.id})}
              class="w-full select select-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[4px]"
            />
          </div>

          <div class="flex justify-end gap-3 pt-4 border-t border-base-300">
            <button
              type="button"
              phx-click="close_create_modal"
              class="btn btn-outline-custom px-4 py-2 rounded-[6px] text-xs font-medium uppercase tracking-wider cursor-pointer"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="btn btn-primary px-4 py-2 rounded-[6px] text-xs font-medium uppercase tracking-wider cursor-pointer"
            >
              Spawn VPN Pair
            </button>
          </div>
        </.form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button type="button" phx-click="close_create_modal">close</button>
      </form>
    </dialog>
  <% end %>
</div>
