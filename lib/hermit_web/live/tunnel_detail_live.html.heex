<div class="text-base-content font-sans antialiased">
  <div class="max-w-7xl mx-auto space-y-8">
    <!-- Back Link and Header -->
    <header class="flex flex-col md:flex-row md:items-center justify-between border-b border-base-300 pb-6">
      <div>
        <h1 class="text-xl sm:text-2xl font-medium tracking-display-lg text-base-content mt-2 uppercase flex items-center gap-3">
          Tunnel Detail: {@id}
          <.status_badge status={@pair.status} />
        </h1>
        <p class="text-base-content/60 mt-1 text-xs sm:text-sm">
          Configure and manage Tailscale and VPN (WireGuard) endpoints sharing network namespace <span class="font-mono text-base-content/85 bg-base-200 px-1.5 py-0.5 rounded-[4px] border border-base-300">
            hermit_wg_{@id}
          </span>.
        </p>
      </div>
      <div class="mt-4 md:mt-0 flex flex-wrap items-center gap-3 w-full md:w-auto">
        <%= case @pair.status do %>
          <% :running -> %>
            <button
              phx-click="stop_tunnel"
              class="btn btn-error btn-outline font-medium tracking-wider px-4 py-2.5 rounded-[6px] transition-colors cursor-pointer text-xs uppercase w-full sm:w-auto justify-center"
            >
              Stop Tunnel
            </button>
            <button
              phx-click="restart_tunnel"
              class="btn btn-outline-custom font-medium tracking-wider px-4 py-2.5 rounded-[6px] transition-colors cursor-pointer text-xs uppercase w-full sm:w-auto justify-center"
            >
              Restart Tunnel
            </button>
          <% status when status in [:starting_wg, :starting_ts] -> %>
            <button
              disabled
              class="btn btn-primary font-medium tracking-wider px-4 py-2.5 rounded-[6px] transition-colors text-xs uppercase opacity-50 flex items-center justify-center gap-2 w-full sm:w-auto"
            >
              <span class="w-3 h-3 border-2 border-t-transparent border-white rounded-full animate-spin"></span>
              Starting...
            </button>
            <button
              phx-click="stop_tunnel"
              class="btn btn-error btn-outline font-medium tracking-wider px-4 py-2.5 rounded-[6px] transition-colors cursor-pointer text-xs uppercase w-full sm:w-auto justify-center"
            >
              Stop Tunnel
            </button>
          <% :error -> %>
            <button
              phx-click="start_tunnel"
              class="btn btn-primary font-medium tracking-wider px-4 py-2.5 rounded-[6px] transition-colors cursor-pointer text-xs uppercase w-full sm:w-auto justify-center"
            >
              Start Tunnel
            </button>
            <button
              phx-click="stop_tunnel"
              class="btn btn-error btn-outline font-medium tracking-wider px-4 py-2.5 rounded-[6px] transition-colors cursor-pointer text-xs uppercase w-full sm:w-auto justify-center"
            >
              Stop Tunnel
            </button>
          <% _ -> %>
            <button
              phx-click="start_tunnel"
              class="btn btn-primary font-medium tracking-wider px-4 py-2.5 rounded-[6px] transition-colors cursor-pointer text-xs uppercase w-full sm:w-auto justify-center"
            >
              Start Tunnel
            </button>
        <% end %>

        <button
          phx-click="delete"
          data-confirm="Are you sure you want to permanently delete this entire Tunnel and all configuration files?"
          class="btn btn-error btn-outline font-medium tracking-wider px-4 py-2.5 rounded-[6px] transition-colors cursor-pointer text-xs uppercase w-full sm:w-auto justify-center"
        >
          Delete Entire Tunnel
        </button>
      </div>
    </header>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-base-300 space-x-8 mb-6">
      <button
        phx-click="set_tab"
        phx-value-tab="overview"
        class={"pb-4 text-xs font-medium uppercase tracking-wider border-b-2 transition-colors cursor-pointer " <> if(@active_tab == :overview, do: "border-[#3ecf8e] text-base-content", else: "border-transparent text-base-content/60 hover:text-base-content")}
      >
        Overview
      </button>
    </div>

    <!-- Active Tab: Overview -->
    <div class={if @active_tab != :overview, do: "hidden"}>
      <!-- Connection Details Status Section -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Inbound Connection Status Card -->
        <%= if @pair.inbound_module == Hermit.Vpn.Inbound.Proxy do %>
          <.proxy_status_card pair={@pair} />
        <% else %>
          <.tailscale_status_card
            id={@id}
            pair={@pair}
            system_dns={@system_dns}
            use_tailscale_dns={@use_tailscale_dns}
            routed_summary={@routed_summary}
          />
        <% end %>

        <!-- Outbound Gateway Status Card -->
        <.outbound_gateway_card id={@id} pair={@pair} wg_info={@wg_info} />
      </div>

      <!-- Real-time Metrics Info Dashboard -->
      <.realtime_metrics_panel pair={@pair} uptime={@uptime} />
    </div>
  </div>

  <.edit_wg_modal id={@id} show={@show_edit_modal} form={@form} />
</div>
