<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-base-300 pb-5">
    <div>
      <h1 class="text-xl sm:text-2xl font-medium tracking-display-lg text-base-content uppercase">
        DNS Endpoints
      </h1>
      <p class="text-xs text-base-content/60 mt-1">
        Configure client connections via secure DoH (iOS, macOS, Android, Browsers) or private Tailscale mesh networks.
      </p>
    </div>
    <button
      id="create-endpoint-btn"
      phx-click="open_new_modal"
      class="btn btn-primary btn-sm rounded-[6px] gap-1.5 font-semibold text-xs text-white uppercase tracking-wider shadow-sm"
    >
      <.icon name="hero-plus" class="size-4" /> Create Endpoint
    </button>
  </div>

  <!-- Endpoints Grid/List -->
  <div class="space-y-4">
    <%= if Enum.empty?(@endpoints) do %>
      <div class="bg-base-100 border border-base-300 rounded-[12px] p-12 text-center shadow-sm">
        <span class="text-4xl block mb-2">🔌</span>
        <h3 class="text-sm font-semibold text-base-content">No DNS Endpoints yet</h3>
        <p class="text-xs text-base-content/50 mt-1 max-w-sm mx-auto">
          Create a DNS Endpoint to connect your iOS, macOS, Android, or Tailscale network to a secure filtering profile.
        </p>
        <button
          phx-click="open_new_modal"
          class="btn btn-primary btn-sm rounded-[6px] mt-4 font-semibold text-xs text-white uppercase tracking-wider"
        >
          Create Endpoint
        </button>
      </div>
    <% else %>
      <%= for endpoint <- @endpoints do %>
        <% {status, ip, err} = Map.get(@dns_statuses, endpoint.id, {:stopped, nil, nil}) %>
        <% config = endpoint.dns_profile %>
        <% doh_url = "#{@base_url}/dns-query/#{endpoint.doh_token}" %>

        <div class="bg-base-100 border border-base-300 rounded-[12px] shadow-sm overflow-hidden transition-all hover:border-base-content/20">
          <!-- Card Top Bar: Title, Tags, Profile Selector, Master Toggle, Actions -->
          <div class="px-5 py-4 border-b border-base-200 bg-base-200/30 flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-3">
              <!-- Name & Icon -->
              <div class="flex items-center gap-2">
                <span class="text-lg">
                  <%= cond do %>
                    <% endpoint.inbound_profile_id -> %>
                      🌐
                    <% endpoint.ddns_hostname && endpoint.ddns_hostname != "" -> %>
                      ⚡
                    <% true -> %>
                      🛡️
                  <% end %>
                </span>
                <h3 class="font-bold text-base text-base-content tracking-tight">
                  {endpoint.name}
                </h3>
              </div>

              <!-- Connection Type Tag -->
              <%= cond do %>
                <% endpoint.inbound_profile_id -> %>
                  <span class="badge badge-sm font-semibold bg-emerald-500/10 text-emerald-500 border-emerald-500/20">
                    Tailscale Connection
                  </span>
                <% endpoint.ddns_hostname && endpoint.ddns_hostname != "" -> %>
                  <span class="badge badge-sm font-semibold bg-amber-500/10 text-amber-500 border-amber-500/20">
                    Port 53 DDNS
                  </span>
                <% true -> %>
                  <span class="badge badge-sm font-semibold bg-blue-500/10 text-blue-500 border-blue-500/20">
                    DoH Only
                  </span>
              <% end %>

              <!-- Compact DNS Profile Selector -->
              <form
                phx-change="quick_select_dns_profile"
                id={"quick-select-dns-form-#{endpoint.id}"}
                class="inline-flex items-center gap-1.5 bg-base-100 border border-base-300 rounded-[6px] px-2 py-0.5"
              >
                <input type="hidden" name="endpoint_id" value={endpoint.id} />
                <span class="text-[10px] uppercase font-semibold text-base-content/50">Profile:</span>
                <select
                  name="dns_profile_id"
                  class="bg-transparent border-0 text-xs font-semibold text-base-content focus:outline-none cursor-pointer py-0.5 pr-4 pl-0"
                >
                  <%= for profile <- @dns_profiles do %>
                    <option value={profile.id} selected={endpoint.dns_profile_id == profile.id}>
                      {profile.name}
                    </option>
                  <% end %>
                </select>
              </form>
            </div>

            <!-- Right Controls: Master Power Toggle & Action Icons -->
            <div class="flex items-center gap-3">
              <!-- Master Active Switch (Prominently Placed) -->
              <div class="flex items-center gap-2 bg-base-100 border border-base-300 rounded-[6px] px-2.5 py-1 shadow-2xs">
                <span class={[
                  "size-2 rounded-full",
                  endpoint.enabled && "bg-emerald-500 animate-pulse",
                  !endpoint.enabled && "bg-base-content/30"
                ]} />
                <span class="text-xs font-semibold text-base-content/80">
                  {if endpoint.enabled, do: "Active", else: "Inactive"}
                </span>
                <button
                  type="button"
                  phx-click="toggle_endpoint_enabled"
                  phx-value-id={endpoint.id}
                  class={[
                    "relative inline-flex h-5 w-9 shrink-0 rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out cursor-pointer ml-1",
                    endpoint.enabled && "bg-emerald-500",
                    !endpoint.enabled && "bg-base-300"
                  ]}
                  title={
                    if endpoint.enabled, do: "Click to Deactivate", else: "Click to Activate"
                  }
                >
                  <span class={[
                    "pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out",
                    endpoint.enabled && "translate-x-4",
                    !endpoint.enabled && "translate-x-0"
                  ]} />
                </button>
              </div>

              <!-- Edit & Delete -->
              <div class="flex items-center gap-1">
                <button
                  phx-click="edit_endpoint"
                  phx-value-id={endpoint.id}
                  class="btn btn-ghost btn-xs text-base-content/60 hover:text-primary rounded-[6px]"
                  title="Edit Endpoint"
                >
                  <.icon name="hero-pencil-square" class="size-4" />
                </button>
                <button
                  phx-click="delete_endpoint"
                  phx-value-id={endpoint.id}
                  data-confirm="Are you sure you want to delete this endpoint?"
                  class="btn btn-ghost btn-xs text-base-content/60 hover:text-error rounded-[6px]"
                  title="Delete Endpoint"
                >
                  <.icon name="hero-trash" class="size-4" />
                </button>
              </div>
            </div>
          </div>

          <!-- Card Body: 2 Clean Columns -->
          <div class="p-5 grid grid-cols-1 lg:grid-cols-12 gap-5">
            <!-- Left Side: Connection & Network Node Info (7 cols) -->
            <div class="lg:col-span-7 space-y-3">
              <%= if endpoint.inbound_profile_id do %>
                <!-- Tailscale Network Node Panel -->
                <div class="bg-base-200/30 border border-base-300/70 rounded-[8px] p-4 space-y-3">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-semibold uppercase tracking-wider text-base-content/70">
                        Tailscale Mesh Node
                      </span>
                      <span class="text-xs text-base-content/50">
                        ({if endpoint.inbound_profile,
                          do: endpoint.inbound_profile.name,
                          else: "Inbound ##{endpoint.inbound_profile_id}"})
                      </span>
                    </div>

                    <div class="flex items-center gap-2">
                      <span class={[
                        "badge badge-sm font-semibold",
                        status == :running && "badge-success text-white",
                        status == :starting && "badge-warning text-white",
                        status == :error && "badge-error text-white",
                        status == :stopped && "badge-ghost text-base-content/60"
                      ]}>
                        <%= case status do %>
                          <% :running -> %>
                            running
                          <% :starting -> %>
                            starting
                          <% :error -> %>
                            error
                          <% :stopped -> %>
                            stopped
                        <% end %>
                      </span>
                      <%= if status in [:error, :stopped] and endpoint.enabled do %>
                        <button
                          type="button"
                          phx-click="reconnect_node"
                          phx-value-id={endpoint.id}
                          class="btn btn-ghost btn-xs text-xs text-primary underline px-1"
                        >
                          Reconnect
                        </button>
                      <% end %>
                    </div>
                  </div>

                  <%= if status == :error and err do %>
                    <div class="text-[11px] text-error bg-error/10 border border-error/20 rounded-[6px] px-2.5 py-1.5">
                      Error: {err}
                    </div>
                  <% end %>

                  <div class="grid grid-cols-2 gap-2 pt-0.5">
                    <div class="bg-base-100 border border-base-300/80 rounded-[6px] p-2.5">
                      <span class="text-[10px] uppercase font-semibold text-base-content/50 block">Tailscale IP</span>
                      <code class="text-xs font-mono font-bold text-base-content select-all">
                        {ip || if status == :starting, do: "Connecting...", else: "Offline"}
                      </code>
                    </div>
                    <div class="bg-base-100 border border-base-300/80 rounded-[6px] p-2.5">
                      <span class="text-[10px] uppercase font-semibold text-base-content/50 block">Direct UDP Port</span>
                      <code class="text-xs font-mono font-bold text-emerald-500">
                        UDP {Hermit.Vpn.Inbound.Tailscale.resolve_port(
                          "dns_#{endpoint.id}",
                          (endpoint.inbound_profile && endpoint.inbound_profile.config) || %{}
                        )}
                      </code>
                    </div>
                  </div>

                  <!-- Tailscale Global DNS Override (HA Mode) -->
                  <div class="bg-base-100 border border-base-300/80 rounded-[6px] p-3 flex items-center justify-between gap-3">
                    <div>
                      <span class="text-xs font-semibold text-base-content flex items-center gap-1.5">
                        Tailscale Global DNS Override
                        <span class="badge badge-xs font-semibold bg-emerald-500/10 text-emerald-500 border-emerald-500/20">HA Multi-Node</span>
                      </span>
                      <span class="text-[10px] text-base-content/55 block mt-0.5">
                        Registers this node into Tailscale global nameservers with high availability.
                      </span>
                    </div>
                    <button
                      type="button"
                      phx-click="toggle_override_dns"
                      phx-value-id={endpoint.id}
                      disabled={status != :running}
                      class={[
                        "relative inline-flex h-5 w-9 shrink-0 rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out",
                        config && config.tailscale_override_dns && "bg-emerald-500",
                        !(config && config.tailscale_override_dns) && "bg-base-300",
                        status == :running && "cursor-pointer",
                        status != :running && "opacity-40 cursor-not-allowed"
                      ]}
                      title={
                        if status != :running,
                          do: "Requires active node to toggle",
                          else: "Toggle Global DNS"
                      }
                    >
                      <span class={[
                        "pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out",
                        config && config.tailscale_override_dns && "translate-x-4",
                        !(config && config.tailscale_override_dns) && "translate-x-0"
                      ]} />
                    </button>
                  </div>
                </div>
              <% else %>
                <%= if endpoint.ddns_hostname && endpoint.ddns_hostname != "" do %>
                  <!-- DDNS Matcher Panel -->
                  <% ddns_info = Map.get(@ddns_map, endpoint.id) %>
                  <div class="bg-base-200/30 border border-base-300/70 rounded-[8px] p-4 space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-semibold uppercase tracking-wider text-base-content/70">
                        Port 53 DDNS IP Matcher
                      </span>
                      <span class="badge badge-sm font-semibold badge-success text-white">
                        Standard Port 53
                      </span>
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                      <div class="bg-base-100 border border-base-300/80 rounded-[6px] p-2.5">
                        <span class="text-[10px] uppercase font-semibold text-base-content/50 block">DDNS Hostname</span>
                        <code class="text-xs font-mono font-bold text-base-content select-all">{endpoint.ddns_hostname}</code>
                      </div>
                      <div class="bg-base-100 border border-base-300/80 rounded-[6px] p-2.5">
                        <span class="text-[10px] uppercase font-semibold text-base-content/50 block">Matched WAN IP</span>
                        <code class="text-xs font-mono font-bold text-emerald-500">
                          {if ddns_info, do: ddns_info.ip, else: "Resolving..."}
                        </code>
                      </div>
                    </div>

                    <div class="bg-base-100 border border-base-300/80 rounded-[6px] p-3 flex items-center justify-between gap-3">
                      <div>
                        <span class="text-xs font-semibold text-base-content block">Strict DDNS IP Filtering</span>
                        <span class="text-[10px] text-base-content/55 block">Only process DNS requests matching the current DDNS WAN IP.</span>
                      </div>
                      <button
                        type="button"
                        phx-click="toggle_ddns_filter"
                        phx-value-id={endpoint.id}
                        class={[
                          "badge badge-sm font-semibold cursor-pointer border",
                          endpoint.enable_ddns_filter != false &&
                            "bg-emerald-500/10 text-emerald-500 border-emerald-500/20",
                          endpoint.enable_ddns_filter == false &&
                            "bg-amber-500/10 text-amber-500 border-amber-500/20"
                        ]}
                      >
                        {if endpoint.enable_ddns_filter != false,
                          do: "Strict Filter ON",
                          else: "Allow All IPs"}
                      </button>
                    </div>
                  </div>
                <% else %>
                  <!-- Direct DoH Endpoint Info -->
                  <div class="bg-base-200/30 border border-base-300/70 rounded-[8px] p-4 flex flex-col justify-between h-full space-y-3">
                    <div class="space-y-1.5">
                      <div class="flex items-center gap-2">
                        <span class="text-xs font-semibold uppercase tracking-wider text-base-content/70">
                          Secure DoH Direct
                        </span>
                        <span class="badge badge-sm font-semibold bg-blue-500/10 text-blue-500 border-blue-500/20">
                          RFC 8484
                        </span>
                      </div>
                      <p class="text-xs text-base-content/65 leading-relaxed">
                        Processes high-performance encrypted DNS over HTTPS queries directly. Ideal for personal iPhones, iPads, Macs, Android devices, and modern web browsers.
                      </p>
                    </div>

                    <div class="pt-3 border-t border-base-300/60 text-[11px] text-base-content/55 flex items-center gap-1.5">
                      <.icon name="hero-check-circle" class="size-4 text-emerald-500 shrink-0" />
                      <span>Zero client apps needed when installing the Apple Configuration Profile.</span>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>

            <!-- Right Side: DoH URL & Client Installation Tools (5 cols) -->
            <div class="lg:col-span-5 bg-base-200/20 border border-base-300/70 rounded-[8px] p-4 flex flex-col justify-between space-y-3">
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-semibold uppercase tracking-wider text-base-content/70 flex items-center gap-1.5">
                    🛡️ DNS-over-HTTPS (DoH)
                  </span>
                  <a
                    href={"#{doh_url}/mobileconfig"}
                    class="btn btn-outline btn-xs gap-1 text-[10px] font-semibold uppercase tracking-wider rounded-[6px] text-primary"
                    title="Download Apple Mobileconfig Profile"
                  >
                    <.icon name="hero-arrow-down-tray" class="size-3" /> Apple Profile
                  </a>
                </div>

                <div class="flex items-center gap-1 bg-base-100 border border-base-300 rounded-[6px] px-2 py-1.5 shadow-2xs">
                  <code class="text-[11px] font-mono text-emerald-500 flex-1 truncate select-all">{doh_url}</code>
                  <button
                    type="button"
                    data-url={doh_url}
                    onclick="navigator.clipboard.writeText(this.getAttribute('data-url')).then(() => alert('DoH URL Copied!'))"
                    class="btn btn-ghost btn-xs text-base-content/50 hover:text-emerald-500 cursor-pointer px-1.5"
                    title="Copy DoH URL"
                  >
                    <.icon name="hero-clipboard" class="size-4" />
                  </button>
                </div>
              </div>

              <!-- Quick Tools Footer -->
              <div class="pt-2 border-t border-base-200/80 flex items-center justify-between gap-2">
                <span class="text-[10px] text-base-content/55">
                  Token:
                  <code class="font-mono font-bold text-base-content/75">{endpoint.doh_token}</code>
                </span>

                <!-- QR Dropdown -->
                <div class="dropdown dropdown-top dropdown-end">
                  <label
                    tabindex="0"
                    class="btn btn-ghost btn-xs text-[10px] uppercase font-semibold text-base-content/70 hover:text-primary gap-1 cursor-pointer"
                  >
                    <.icon name="hero-qr-code" class="size-3.5" /> Scan QR
                  </label>
                  <div
                    tabindex="0"
                    class="dropdown-content z-[1] p-3 bg-base-100 border border-base-300 rounded-[12px] shadow-lg mb-2 text-center w-44"
                  >
                    <div class="bg-white p-2 rounded-[6px] border border-base-300 shadow-inner inline-block">
                      <img
                        src={"https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=#{URI.encode_www_form(doh_url)}"}
                        alt="DoH QR Code"
                        class="size-[120px]"
                      />
                    </div>
                    <span class="text-[9px] uppercase tracking-wider text-base-content/50 font-semibold block mt-1.5">Scan to configure DoH</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- Modal Create Endpoint -->
  <%= if @show_new_modal do %>
    <div class="modal modal-open">
      <div class="modal-box rounded-[12px] border border-base-300 max-w-md bg-base-100 shadow-xl">
        <div class="flex items-center justify-between mb-4 border-b border-base-200 pb-3">
          <h3 class="font-bold text-base text-base-content flex items-center gap-2">
            🔌 Create DNS Endpoint
          </h3>
          <button
            type="button"
            phx-click="close_new_modal"
            class="btn btn-ghost btn-xs text-base-content/50 hover:text-base-content"
          >
            ✕
          </button>
        </div>

        <.form
          :let={f}
          for={@new_form}
          phx-change="validate_new"
          phx-submit="save_new"
          id="create-endpoint-form"
          class="space-y-4"
        >
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold uppercase tracking-wider text-base-content/60">
              Endpoint Name
            </label>
            <.input
              field={f[:name]}
              type="text"
              placeholder="e.g. iPhone Personal, Office Mac"
              class="w-full input input-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[6px]"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs font-semibold uppercase tracking-wider text-base-content/60">
              DNS Filtering Profile
            </label>
            <.input
              field={f[:dns_profile_id]}
              type="select"
              prompt="-- Choose Profile --"
              options={Enum.map(@dns_profiles, &{&1.name, &1.id})}
              class="w-full select select-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[6px]"
            />
          </div>

          <!-- Connection Type Selection (Segmented Control) -->
          <div class="space-y-1.5 pt-1">
            <label class="block text-xs font-semibold uppercase tracking-wider text-base-content/60">
              Connection Type
            </label>
            <div class="grid grid-cols-3 gap-2 bg-base-200/50 p-1 rounded-[8px] border border-base-300/60">
              <button
                type="button"
                phx-click="select_new_type"
                phx-value-type="doh"
                class={[
                  "btn btn-xs rounded-[6px] font-semibold text-[11px] border-0 transition-all",
                  @new_connection_type == "doh" && "bg-base-100 text-primary shadow-xs font-bold",
                  @new_connection_type != "doh" && "btn-ghost text-base-content/70"
                ]}
              >
                🛡️ DoH Only
              </button>
              <button
                type="button"
                phx-click="select_new_type"
                phx-value-type="tailscale"
                class={[
                  "btn btn-xs rounded-[6px] font-semibold text-[11px] border-0 transition-all",
                  @new_connection_type == "tailscale" &&
                    "bg-base-100 text-primary shadow-xs font-bold",
                  @new_connection_type != "tailscale" && "btn-ghost text-base-content/70"
                ]}
              >
                🌐 Tailscale
              </button>
              <button
                type="button"
                phx-click="select_new_type"
                phx-value-type="ddns"
                class={[
                  "btn btn-xs rounded-[6px] font-semibold text-[11px] border-0 transition-all",
                  @new_connection_type == "ddns" &&
                    "bg-base-100 text-primary shadow-xs font-bold",
                  @new_connection_type != "ddns" && "btn-ghost text-base-content/70"
                ]}
              >
                ⚡ DDNS
              </button>
            </div>
          </div>

          <%= if @new_connection_type == "tailscale" do %>
            <div class="space-y-1.5 p-3.5 bg-base-200/40 rounded-[8px] border border-base-300">
              <label class="block text-xs font-semibold uppercase tracking-wider text-base-content/60">
                Tailscale Network Profile
              </label>
              <.input
                field={f[:inbound_profile_id]}
                type="select"
                prompt="-- Select Tailscale Inbound --"
                options={Enum.map(@inbound_profiles, &{&1.name, &1.id})}
                class="w-full select select-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[6px]"
              />
              <span class="text-[10px] text-base-content/50 block mt-1">
                Launches an isolated Tailscale mesh node on your tailnet for DNS filtering.
              </span>
            </div>
          <% else %>
            <input type="hidden" name="dns_endpoint[inbound_profile_id]" value="" />
          <% end %>

          <%= if @new_connection_type == "ddns" do %>
            <div class="space-y-3 p-3.5 bg-base-200/40 rounded-[8px] border border-base-300">
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-base-content/60 mb-1">
                  DDNS Hostname
                </label>
                <.input
                  field={f[:ddns_hostname]}
                  type="text"
                  placeholder="e.g. myhome.duckdns.org"
                  class="w-full input input-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[6px]"
                />
              </div>
              <div class="flex items-center justify-between pt-2 border-t border-base-300/60">
                <div>
                  <span class="text-xs font-medium text-base-content block">Strict DDNS IP Filtering</span>
                  <span class="text-[10px] text-base-content/50 block">Only allow requests matching resolved WAN IP.</span>
                </div>
                <.input
                  field={f[:enable_ddns_filter]}
                  type="checkbox"
                  class="checkbox checkbox-primary checkbox-sm rounded-[4px]"
                />
              </div>
            </div>
          <% else %>
            <input type="hidden" name="dns_endpoint[ddns_hostname]" value="" />
          <% end %>

          <div class="modal-action flex items-center justify-end gap-2 pt-4 border-t border-base-300">
            <button
              type="button"
              phx-click="close_new_modal"
              class="btn btn-outline-custom rounded-[6px] text-xs uppercase tracking-wider px-4 py-2 cursor-pointer"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="btn btn-primary rounded-[6px] text-xs uppercase tracking-wider px-4 py-2 cursor-pointer text-white font-semibold"
            >
              Create Endpoint
            </button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <!-- Modal Edit Endpoint -->
  <%= if @show_edit_modal do %>
    <div class="modal modal-open">
      <div class="modal-box rounded-[12px] border border-base-300 max-w-md bg-base-100 shadow-xl">
        <div class="flex items-center justify-between mb-4 border-b border-base-200 pb-3">
          <h3 class="font-bold text-base text-base-content flex items-center gap-2">
            ✏️ Edit DNS Endpoint
          </h3>
          <button
            type="button"
            phx-click="close_edit_modal"
            class="btn btn-ghost btn-xs text-base-content/50 hover:text-base-content"
          >
            ✕
          </button>
        </div>

        <.form
          :let={f}
          for={@edit_form}
          phx-change="validate_edit"
          phx-submit="save_edit"
          id="edit-endpoint-form"
          class="space-y-4"
        >
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold uppercase tracking-wider text-base-content/60">
              Endpoint Name
            </label>
            <.input
              field={f[:name]}
              type="text"
              class="w-full input input-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[6px]"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs font-semibold uppercase tracking-wider text-base-content/60">
              DNS Filtering Profile
            </label>
            <.input
              field={f[:dns_profile_id]}
              type="select"
              prompt="-- Choose Profile --"
              options={Enum.map(@dns_profiles, &{&1.name, &1.id})}
              class="w-full select select-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[6px]"
            />
          </div>

          <!-- Connection Type Selection (Segmented Control) -->
          <div class="space-y-1.5 pt-1">
            <label class="block text-xs font-semibold uppercase tracking-wider text-base-content/60">
              Connection Type
            </label>
            <div class="grid grid-cols-3 gap-2 bg-base-200/50 p-1 rounded-[8px] border border-base-300/60">
              <button
                type="button"
                phx-click="select_edit_type"
                phx-value-type="doh"
                class={[
                  "btn btn-xs rounded-[6px] font-semibold text-[11px] border-0 transition-all",
                  @edit_connection_type == "doh" &&
                    "bg-base-100 text-primary shadow-xs font-bold",
                  @edit_connection_type != "doh" && "btn-ghost text-base-content/70"
                ]}
              >
                🛡️ DoH Only
              </button>
              <button
                type="button"
                phx-click="select_edit_type"
                phx-value-type="tailscale"
                class={[
                  "btn btn-xs rounded-[6px] font-semibold text-[11px] border-0 transition-all",
                  @edit_connection_type == "tailscale" &&
                    "bg-base-100 text-primary shadow-xs font-bold",
                  @edit_connection_type != "tailscale" && "btn-ghost text-base-content/70"
                ]}
              >
                🌐 Tailscale
              </button>
              <button
                type="button"
                phx-click="select_edit_type"
                phx-value-type="ddns"
                class={[
                  "btn btn-xs rounded-[6px] font-semibold text-[11px] border-0 transition-all",
                  @edit_connection_type == "ddns" &&
                    "bg-base-100 text-primary shadow-xs font-bold",
                  @edit_connection_type != "ddns" && "btn-ghost text-base-content/70"
                ]}
              >
                ⚡ DDNS
              </button>
            </div>
          </div>

          <%= if @edit_connection_type == "tailscale" do %>
            <div class="space-y-1.5 p-3.5 bg-base-200/40 rounded-[8px] border border-base-300">
              <label class="block text-xs font-semibold uppercase tracking-wider text-base-content/60">
                Tailscale Network Profile
              </label>
              <.input
                field={f[:inbound_profile_id]}
                type="select"
                prompt="-- Select Tailscale Inbound --"
                options={Enum.map(@inbound_profiles, &{&1.name, &1.id})}
                class="w-full select select-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[6px]"
              />
            </div>
          <% else %>
            <input type="hidden" name="dns_endpoint[inbound_profile_id]" value="" />
          <% end %>

          <%= if @edit_connection_type == "ddns" do %>
            <div class="space-y-3 p-3.5 bg-base-200/40 rounded-[8px] border border-base-300">
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-base-content/60 mb-1">
                  DDNS Hostname
                </label>
                <.input
                  field={f[:ddns_hostname]}
                  type="text"
                  placeholder="e.g. myhome.duckdns.org"
                  class="w-full input input-bordered bg-base-100 border-base-300 focus:border-[#3ecf8e] text-base-content text-sm rounded-[6px]"
                />
              </div>
              <div class="flex items-center justify-between pt-2 border-t border-base-300/60">
                <div>
                  <span class="text-xs font-medium text-base-content block">Strict DDNS IP Filtering</span>
                  <span class="text-[10px] text-base-content/50 block">Only allow requests matching resolved WAN IP.</span>
                </div>
                <.input
                  field={f[:enable_ddns_filter]}
                  type="checkbox"
                  class="checkbox checkbox-primary checkbox-sm rounded-[4px]"
                />
              </div>
            </div>
          <% else %>
            <input type="hidden" name="dns_endpoint[ddns_hostname]" value="" />
          <% end %>

          <div class="modal-action flex items-center justify-end gap-2 pt-4 border-t border-base-300">
            <button
              type="button"
              phx-click="close_edit_modal"
              class="btn btn-outline-custom rounded-[6px] text-xs uppercase tracking-wider px-4 py-2 cursor-pointer"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="btn btn-primary rounded-[6px] text-xs uppercase tracking-wider px-4 py-2 cursor-pointer text-white font-semibold"
            >
              Save Changes
            </button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>
</div>
