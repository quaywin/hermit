<div class="space-y-6">
  <!-- Header Section -->
  <header class="flex flex-col md:flex-row md:items-center justify-between border-b border-base-300 pb-6">
    <div>
      <h1 class="text-xl sm:text-2xl font-medium tracking-display-lg text-base-content uppercase">
        DNS Server Profiles
      </h1>
      <p class="text-base-content/60 mt-1 text-xs sm:text-sm">
        Configure upstream DNS resolvers, blocklists, and monitor real-time Tailscale DNS query logs.
      </p>
    </div>
    <div class="mt-4 md:mt-0 flex flex-wrap items-center gap-3 w-full md:w-auto">
      <button
        phx-click="open_create_modal"
        class="btn btn-primary rounded-[6px] text-xs font-semibold uppercase tracking-wider px-4 py-2 cursor-pointer flex items-center justify-center gap-2 w-full md:w-auto"
      >
        <.icon name="hero-plus" class="size-4" /> Create DNS Profile
      </button>
    </div>
  </header>

  <!-- Horizontal Profile Selector: Tối ưu diện tích thay cho cột dọc -->
  <%= if @dns_profiles != [] do %>
    <div class="flex flex-wrap items-center gap-2 border-b border-base-300 pb-4">
      <span class="text-xs font-semibold uppercase tracking-wider text-base-content/40 mr-2">
        Profiles:
      </span>
      <div class="flex flex-wrap gap-1.5">
        <button
          :for={profile <- @dns_profiles}
          phx-click="select_profile"
          phx-value-id={profile.id}
          class={[
            "px-4 py-2 text-xs font-medium uppercase tracking-wider rounded-[6px] transition-all flex items-center gap-2 cursor-pointer border",
            if(@selected_profile && @selected_profile.id == profile.id,
              do:
                "bg-emerald-500/10 text-emerald-500 border-emerald-500/20 font-semibold shadow-sm",
              else:
                "text-base-content/65 hover:bg-base-200/50 hover:text-base-content border-transparent"
            )
          ]}
        >
          <span>{profile.name}</span>
          <%= if profile_active?(profile) do %>
            <span class="size-1.5 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500/50 animate-pulse" />
          <% else %>
            <span class="size-1.5 rounded-full bg-base-content/25" />
          <% end %>
        </button>
      </div>
    </div>
  <% end %>

  <!-- Main Content Area: Rộng toàn bộ chiều ngang (Full-Width) -->
  <div class="w-full">
    <%= if is_nil(@selected_profile) do %>
      <div class="bg-base-100 border border-base-300 rounded-[12px] p-12 text-center shadow-sm">
        <p class="text-base-content/40 italic">
          No DNS Profiles found. Create one to configure DNS settings.
        </p>
      </div>
    <% else %>
      <div class="space-y-6">
        <.profile_header_card
          selected_profile={@selected_profile}
          editing_name={@editing_name}
          name_form={@name_form}
        />

        <.blocklist_filters_card
          selected_profile={@selected_profile}
          available_blocklists={@available_blocklists}
        />

        <.upstream_and_policies_card selected_profile={@selected_profile} />

        <.resolution_metrics_card
          :if={@dns_metrics}
          selected_profile={@selected_profile}
          dns_metrics={@dns_metrics}
          time_range={@time_range}
        />

        <!-- Realtime DNS Query Logs (kept inline for phx-update="stream") -->
        <div class="bg-base-100 border border-base-300 rounded-[12px] p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-base-300 pb-2 mb-2">
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">
                Realtime DNS Logs
              </h3>
              <p class="text-[11px] text-base-content/40">
                Realtime streams of DNS request traffic under this profile.
                <%= if @pause_logs do %>
                  <span class="text-amber-500 font-semibold uppercase text-[10px] ml-1.5 animate-pulse">
                    (Paused)
                  </span>
                <% end %>
              </p>
            </div>
            <div class="flex items-center gap-2">
              <button
                phx-click="toggle_query_logging"
                class={[
                  "btn btn-xs uppercase tracking-wider text-[10px] rounded-[4px] cursor-pointer flex items-center gap-1.5",
                  if(@selected_profile.enable_query_logging,
                    do: "btn-primary",
                    else: "btn-outline"
                  )
                ]}
              >
                <.icon name="hero-circle-stack" class="size-3.5" />
                {if @selected_profile.enable_query_logging, do: "Logging On", else: "Logging Off"}
              </button>

              <button
                phx-click="toggle_pause_logs"
                class={[
                  "btn btn-xs uppercase tracking-wider text-[10px] rounded-[4px] cursor-pointer flex items-center gap-1.5",
                  if(@pause_logs, do: "btn-success btn-outline", else: "btn-outline")
                ]}
              >
                <%= if @pause_logs do %>
                  <.icon name="hero-play" class="size-3.5" /> Resume Stream
                <% else %>
                  <.icon name="hero-pause" class="size-3.5" /> Pause Stream
                <% end %>
              </button>
              <button
                phx-click="clear_logs"
                class="btn btn-outline btn-xs uppercase tracking-wider text-[10px] rounded-[4px] cursor-pointer"
              >
                Clear Log Buffer
              </button>
            </div>
          </div>

          <div class="overflow-y-auto overflow-x-auto max-h-[350px]">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="text-base-content/40 font-semibold uppercase tracking-wider">
                  <th class="sticky top-0 bg-base-100 pb-2 min-w-[100px] border-b border-base-300 z-10">
                    Client IP
                  </th>
                  <th class="sticky top-0 bg-base-100 pb-2 min-w-[100px] border-b border-base-300 z-10">
                    Device
                  </th>
                  <th class="sticky top-0 bg-base-100 pb-2 min-w-[100px] border-b border-base-300 z-10">
                    Endpoint
                  </th>
                  <th class="sticky top-0 bg-base-100 pb-2 min-w-[180px] border-b border-base-300 z-10">
                    Domain
                  </th>
                  <th class="sticky top-0 bg-base-100 pb-2 min-w-[60px] border-b border-base-300 z-10">
                    Type
                  </th>
                  <th class="sticky top-0 bg-base-100 pb-2 min-w-[95px] border-b border-base-300 z-10">
                    Status
                  </th>
                  <th class="sticky top-0 bg-base-100 pb-2 min-w-[100px] border-b border-base-300 z-10">
                    Source
                  </th>
                  <th class="sticky top-0 bg-base-100 pb-2 min-w-[120px] border-b border-base-300 z-10">
                    Result
                  </th>
                  <th class="sticky top-0 bg-base-100 pb-2 text-right min-w-[80px] border-b border-base-300 z-10">
                    Time
                  </th>
                </tr>
              </thead>
              <tbody
                id="dns-query-logs-table"
                phx-update="stream"
                class="divide-y divide-base-300/40 text-base-content/80 font-mono"
              >
                <tr
                  :for={{dom_id, log} <- @streams.dns_logs}
                  id={dom_id}
                  class="hover:bg-base-200/30 transition-all"
                >
                  <td class="py-2.5 pr-2 font-mono text-base-content/75">{log.client_ip}</td>
                  <td class="py-2.5 pr-2 text-base-content/65 truncate max-w-[120px]">
                    <%= if log.client_name && log.client_name != log.client_ip do %>
                      {log.client_name}
                    <% else %>
                      -
                    <% end %>
                  </td>
                  <td class="py-2.5 pr-2 font-sans text-base-content/65 truncate max-w-[120px]">
                    {log.endpoint_name}
                  </td>
                  <td class="py-2.5 pr-2 font-mono truncate max-w-xs">{log.domain}</td>
                  <td class="py-2.5 pr-2 font-mono uppercase text-base-content/65">
                    {log.qtype}
                  </td>
                  <td class="py-2.5 pr-2 font-sans font-semibold">
                    <span class={[
                      "px-2 py-0.5 rounded-full text-[10px] uppercase font-mono border",
                      case log.status do
                        "blocked" -> "bg-red-500/10 text-red-500 border-red-500/20"
                        "redirected" -> "bg-amber-500/10 text-amber-500 border-amber-500/20"
                        "resolved" -> "bg-emerald-500/10 text-emerald-500 border-emerald-500/20"
                        "smart_routed" -> "bg-sky-500/10 text-sky-500 border-sky-500/20"
                        _ -> "bg-base-content/10 text-base-content/75 border-base-content/20"
                      end
                    ]}>
                      {log.status}
                    </span>
                  </td>
                  <td class="py-2.5 pr-2 font-mono text-[10px] text-base-content/50">
                    {log.resolver}
                  </td>
                  <td class="py-2.5 pr-2 text-base-content/60 truncate max-w-xs">
                    {log.answer}
                  </td>
                  <td
                    id={"log-time-#{dom_id}"}
                    phx-hook="LocalTime"
                    data-timestamp={DateTime.to_unix(log.timestamp)}
                    class="py-2.5 text-right text-base-content/40"
                  >
                    {Calendar.strftime(log.timestamp, "%H:%M:%S")}
                  </td>
                </tr>
              </tbody>
              <tfoot id="empty-logs-tfoot" class={if @has_logs, do: "hidden"}>
                <tr>
                  <td colspan="9" class="py-8 text-center text-base-content/30 italic">
                    No logs captured yet. Capture will start when queries begin.
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <.create_profile_modal show={@show_create_modal} create_form={@create_form} />
</div>
