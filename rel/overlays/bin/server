#!/bin/sh
set -eu

# Prevent rapid crash loops from consuming 100% CPU
STORAGE_DIR="/app/storage"
LAST_START_FILE="$STORAGE_DIR/.last_startup"
RESTART_COUNT_FILE="$STORAGE_DIR/.rapid_restarts"

if [ -d "$STORAGE_DIR" ] && [ -w "$STORAGE_DIR" ]; then
  CURRENT_TIME=$(date +%s)
  if [ -f "$LAST_START_FILE" ] && [ -f "$RESTART_COUNT_FILE" ]; then
    LAST_TIME=$(cat "$LAST_START_FILE")
    DIFF=$((CURRENT_TIME - LAST_TIME))
    if [ "$DIFF" -lt 15 ]; then
      COUNT=$(cat "$RESTART_COUNT_FILE")
      COUNT=$((COUNT + 1))
      echo "$COUNT" > "$RESTART_COUNT_FILE"
      if [ "$COUNT" -ge 5 ]; then
        echo "ERROR: Rapid crash loop detected ($COUNT restarts). Cooling down for 60 seconds to prevent CPU spike..."
        echo "0" > "$RESTART_COUNT_FILE"
        sleep 60
      fi
    else
      echo "0" > "$RESTART_COUNT_FILE"
    fi
  else
    echo "0" > "$RESTART_COUNT_FILE"
  fi
  echo "$CURRENT_TIME" > "$LAST_START_FILE"
fi

cd -P -- "$(dirname -- "$0")"

# Setup 512MB swap memory on Fly.io if permitted and not active
if [ -n "${FLY_APP_NAME:-}" ] || [ "${ENABLE_SWAP:-false}" = "true" ]; then
  if [ -w /proc/sys/vm/swappiness ] && [ "$(swapon --show | wc -l)" -le 1 ]; then
    if [ ! -f /swapfile ]; then
      echo "Creating and activating 512MB swap file..."
      (fallocate -l 512M /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=512) 2>/dev/null || true
      chmod 0600 /swapfile 2>/dev/null || true
      mkswap /swapfile 2>/dev/null || true
    fi
    swapon /swapfile 2>/dev/null || true
    sysctl -w vm.swappiness=10 2>/dev/null || true
    sysctl -w vm.overcommit_memory=1 2>/dev/null || true
  fi
fi

# Apply host-level performance tunings if running with sufficient privileges
if sysctl -w net.core.rmem_max=750000000 >/dev/null 2>&1; then
  echo "Applying network performance tuning..."
  sysctl -w net.core.wmem_max=750000000 >/dev/null 2>&1 || true
  sysctl -w net.core.rmem_default=750000000 >/dev/null 2>&1 || true
  sysctl -w net.core.wmem_default=750000000 >/dev/null 2>&1 || true
  sysctl -w net.core.netdev_max_backlog=250000 >/dev/null 2>&1 || true
  sysctl -w net.ipv4.udp_mem="379008 504512 759360" >/dev/null 2>&1 || true
  sysctl -w net.netfilter.nf_conntrack_max=1048576 >/dev/null 2>&1 || true
fi

PHX_SERVER=true exec ./hermit start
